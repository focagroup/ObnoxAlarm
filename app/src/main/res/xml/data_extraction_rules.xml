<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Obnoxious mode must not come back after a reinstall. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="obnoxious_lock.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="obnoxious_lock.xml" />
    </device-transfer>
</data-extraction-rules>
